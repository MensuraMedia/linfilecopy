# LinFileCopy icon manifest
# Every icon the app (and its mockups) may use. Source: local Phosphor v2.0.8 (MIT).
# Columns: semantic-id  phosphor-name  weight  purpose
# Vendored as data/icons/scalable/actions/lfc-<semantic-id>-symbolic.svg

# --- navigation -----------------------------------------------------------
nav-dashboard            squares-four             regular  Dashboard page
nav-dashboard-active     squares-four             fill     Dashboard page (selected)
nav-designer             sliders-horizontal       regular  Job Designer page
nav-designer-active      sliders-horizontal       fill     Job Designer page (selected)
nav-transfers            pulse                    regular  Active Transfers page
nav-transfers-active     pulse                    fill     Active Transfers page (selected)
nav-history              clock-counter-clockwise  regular  History & Logs page
nav-history-active       clock-counter-clockwise  fill     History & Logs page (selected)
nav-scheduler            calendar-check           regular  Scheduler page
nav-scheduler-active     calendar-check           fill     Scheduler page (selected)
nav-settings             gear-six                 regular  Settings page
nav-settings-active      gear-six                 fill     Settings page (selected)
app-menu                 list                     regular  Header bar main menu
sidebar-toggle           sidebar-simple           regular  Collapse/expand sidebar (narrow layout)

# --- job control ----------------------------------------------------------
action-start             play                     fill     Start / resume a job (primary)
action-pause             pause                    regular  Pause a running job
action-cancel            stop                     regular  Cancel a running job
action-preview           eye                      regular  Preview (dry run)
action-rerun             arrow-clockwise          regular  Run again from history
action-retry             arrow-counter-clockwise  regular  Retry failed run
action-new               plus                     regular  New job / add row
action-remove            minus                    regular  Remove row
action-save              floppy-disk              regular  Save job
action-duplicate         copy-simple              regular  Duplicate job
action-delete            trash                    regular  Delete job
action-templates         stack                    regular  Job templates menu
action-import            arrow-square-in          regular  Import job file
action-export            arrow-square-out         regular  Export job file
action-copy-command      clipboard-text           regular  Copy command to clipboard
action-browse            folder-open              regular  Browse for folder
action-drop              hand-grabbing            regular  Drag-and-drop hint
action-swap              arrows-down-up           regular  Swap source and destination
action-test              flask                    regular  Test connection / filters
action-search            magnifying-glass         regular  Search
action-open-log          scroll                   regular  Open run log
action-move-up           caret-up                 regular  Move filter rule up
action-move-down         caret-down               regular  Move filter rule down
action-expand            caret-right              regular  Collapsed section
action-collapse          caret-down               regular  Expanded section
action-more              dots-three-vertical      regular  Row overflow menu
action-close             x                        regular  Close dialog / dismiss
action-install           download-simple          regular  Show install instructions
action-edit              pencil-simple            regular  Edit job
misc-info                info                     regular  Inline help
misc-shortcuts           keyboard                 regular  Keyboard shortcuts
misc-theme               circle-half              regular  Theme selector
misc-command             terminal-window          regular  Command preview pane

# --- endpoints (#10, #20, B1) ---------------------------------------------
ep-local                 hard-drives              regular  Local folder
ep-ssh                   terminal                 regular  SSH host
ep-cloud                 cloud                    regular  rclone remote
ep-crypt                 lock-key                 regular  rclone crypt remote
ep-key                   key                      regular  SSH key file
ep-password              password                 regular  Password field
ep-source                upload-simple            regular  Source side caption
ep-destination           download-simple          regular  Destination side caption
ep-folder                folder-simple            regular  Folder in lists

# --- modes & policies (B2, B9, #13) ---------------------------------------
mode-copy                arrow-right              regular  One-way copy
mode-mirror              arrows-clockwise         regular  Mirror (sync, deletes extras)
mode-twoway              arrows-left-right        regular  Two-way sync
policy-conflict          scales                   regular  Conflict policy
policy-overwrite         swap                     regular  Overwrite existing
policy-skip              skip-forward             regular  Skip existing
policy-newer             clock-clockwise          regular  Overwrite if newer

# --- features (Advanced view section headers) -----------------------------
feat-delta               git-diff                 regular  #1 Delta transfer
feat-incremental         list-checks              regular  #2 Incremental / compare method
feat-metadata            tag                      regular  #3 Metadata preservation
feat-dryrun              eye                      regular  #4 Dry run
feat-filters             funnel                   regular  #5 Filters
feat-bandwidth           gauge                    regular  #6 Bandwidth limit
feat-resume              play-pause               regular  #7 Resume partial transfers
feat-checksum            fingerprint              regular  #8 Checksum verification
feat-compress            file-zip                 regular  #9 Compression
feat-security            lock-key                 regular  #10 Secure transport
feat-stats               chart-line-up            regular  #11 Progress & statistics
feat-parallel            rows                     regular  #12 Parallel transfers
feat-bidirectional       arrows-left-right        regular  #13 Bidirectional sync
feat-realtime            lightning                regular  #14 Real-time sync
feat-sparse              file-dashed              regular  #15 Sparse files
feat-atomic              atom                     regular  #16 Atomic replace
feat-snapshots           camera                   regular  #17 Snapshots
feat-linkdest            link                     regular  #17 link-dest path
feat-logging             scroll                   regular  #18 Logging
feat-notify              bell                     regular  #18 / B10 Notifications
feat-schedule            calendar-check           regular  #19 Scheduling
feat-cron                clock                    regular  #19 Custom cron
feat-backends            plugs-connected          regular  #20 Multi-backend

# --- exclude presets (B6) -------------------------------------------------
preset-hidden            eye-slash                regular  Skip hidden files
preset-cache             broom                    regular  Skip cache folders
preset-temp              hourglass                regular  Skip temp files
preset-system            prohibit                 regular  Skip system folders
preset-custom            funnel-simple            regular  Custom rules

# --- status ---------------------------------------------------------------
status-running           circle-notch             bold     Running (spins)
status-paused            pause-circle             fill     Paused
status-success           check-circle             fill     Completed
status-warning           warning-circle           fill     Completed with warnings
status-failed            x-circle                 fill     Failed
status-cancelled         prohibit                 bold     Cancelled
status-scheduled         clock                    fill     Scheduled
status-queued            hourglass                fill     Queued
status-missing-tool      warning                  fill     Required tool missing
status-dryrun            eye                      fill     Dry-run badge

# --- stats / empty states -------------------------------------------------
stat-data                database                 duotone  Data copied tile
stat-files               files                    duotone  Files tile
stat-time                timer                    duotone  Duration tile
stat-jobs                stack                    duotone  Jobs tile
empty-history            clock-counter-clockwise  light    Empty history
empty-transfers          pulse                    light    No active transfers
delta-create             plus-circle              fill     Preview: new file
delta-update             arrow-circle-up          fill     Preview: updated file
delta-delete             minus-circle             fill     Preview: deleted file
